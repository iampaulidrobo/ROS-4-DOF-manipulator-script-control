<?xml version="1.0"?>
<launch>
    <include file="$(find gazebo_ros)/launch/empty_world.launch" />
    <arg name="x" default="0"/>
    <arg name="y" default="0"/>
    <arg name="z" default="0"/>
    <arg name="marotte" />
    <arg name="gui" default="true" />
    <param name="robot_description" textfile="$(find marotte_script_control)/urdf/transmission_marotte_E.urdf" />


    <node name="tf_footprint_base" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 0 base_link base_footprint 40" />

    <node name="spawn_model" pkg="gazebo_ros" type="spawn_model" args="-urdf -model marotte -param robot_description -x $(arg x) -y $(arg y) -z $(arg z)" output="screen" />

    <!-- Load joint controller configurations from YAML file to parameter server -->
    <rosparam file="$(find marotte_script_control)/config/marotte_control_E_P.yaml" command="load"/>

    <!-- load the controllers -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="/marotte" 
    args="joint1_position_controller joint2_position_controller joint3_position_controller 
    joint4_position_controller joint5_1_position_controller 
    joint5_2_position_controller joint_state_controller"/>
    
</launch> 